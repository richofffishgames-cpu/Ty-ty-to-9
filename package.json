{
  "name": "crypto-platform-manager",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --d1=crypto-platform-production --local --ip 0.0.0.0 --port 3000",
    "build": "vite build",
    "preview": "wrangler pages dev",
    "deploy": "npm run build && wrangler pages deploy",
    "deploy:prod": "npm run build && wrangler pages deploy --project-name crypto-platform-manager",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "db:migrate:local": "wrangler d1 migrations apply crypto-platform-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply crypto-platform-production",
    "db:seed": "wrangler d1 execute crypto-platform-production --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed",
    "db:console:local": "wrangler d1 execute crypto-platform-production --local",
    "db:console:prod": "wrangler d1 execute crypto-platform-production",
    "git:init": "git init && git add . && git commit -m 'Initial commit'",
    "git:commit": "git add . && git commit -m",
    "git:status": "git status",
    "git:log": "git log --oneline",
    "clean-port": "fuser -k 3000/tcp 2>/dev/null || true",
    "test": "curl http://localhost:3000",
    "docker:build": "docker build -t crypto-platform-backend .",
    "docker:run": "docker run -p 8787:8787 --env-file .env crypto-platform-backend",
    "docker:compose": "docker-compose up -d",
    "k8s:apply": "kubectl apply -f k8s/",
    "k8s:delete": "kubectl delete -f k8s/",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@hono/zod-validator": "^0.7.6",
    "@tanstack/react-query": "^4.36.1",
    "@trpc/client": "^10.45.4",
    "@trpc/react-query": "^10.45.4",
    "@trpc/server": "^10.45.4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/jsonwebtoken": "^9.0.10",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "bitcoinjs-lib": "^7.0.1",
    "bullmq": "^5.70.4",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "decimal.js": "^10.4.3",
    "drizzle-kit": "^0.31.9",
    "drizzle-orm": "^0.29.5",
    "express-rate-limit": "^8.3.0",
    "helmet": "^8.1.0",
    "hono": "^4.12.5",
    "ioredis": "^5.10.0",
    "jose": "^5.2.0",
    "jsonwebtoken": "^9.0.3",
    "postgres": "^3.4.8",
    "puppeteer": "^21.11.0",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "redis": "^5.11.0",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241230.0",
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-dev-server": "^0.18.2",
    "@types/crypto-js": "^4.2.1",
    "@types/node": "^20.19.37",
    "@types/react": "^18.2.45",
    "@types/react-dom": "^18.2.18",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.3",
    "vite": "^6.3.5",
    "vitest": "^1.1.3",
    "wrangler": "^4.4.0"
  }
}
